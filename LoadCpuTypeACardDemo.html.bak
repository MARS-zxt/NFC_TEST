<!doctype html>

<html lang="en">



<head>

    <meta charset="UTF-8">

    <title>TypeACPU Card Demo</title>

    <style type="text/css">

        table {

            width: 500px;

            margin: 10px auto;

            border-collapse: collapse;

        }

        body {

           background-image: url('image/vector-art-colorful-8140x8140-12144.jpg');

           background-size: cover;

           background-attachment: fixed;

           font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
           -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;

           margin: 0;

           padding: 40px 20px;

        }

        .content-wrapper {

        max-width: 1300px;

        margin: 0 auto;

        background: rgba(255, 255, 255, 0.92);

        backdrop-filter: blur(2px);

        border-radius: 24px;

        padding: 20px 30px;

        box-shadow: 0 8px 20px rgba(0,0,0,0.15);

        }

         .glass-card {

            max-width: 1300px;

            margin: 0 auto;

            background: rgba(255, 255, 255, 0.62);

            backdrop-filter: blur(24px) saturate(1.2);

            -webkit-backdrop-filter: blur(24px) saturate(1.2);

            border-radius: 28px;

            padding: 28px 32px;

            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);

            border: 1px solid rgba(255, 255, 255, 0.35);

            transition: all 0.3s ease;

        }

        .formtd,

        .formth {

            border: 1px solid #333;

        }

         h3 {

            text-align: center;

            font-size: 24px;

            font-weight: 600;

            margin: 0 0 28px 0;

            color: #1e293b;

            letter-spacing: 1px;

            position: relative;

            padding-bottom: 12px;

        }

        

        h3::after {

            content: '';

            position: absolute;

            bottom: 0;

            left: 50%;

            transform: translateX(-50%);

            width: 80px;

            height: 3px;

            background: linear-gradient(90deg, #007bff, #00c6ff);

            border-radius: 2px;

        }



 /* 表格样式优化 */

        .gas-table {

            width: 100%;

            table-layout: fixed;

            border-collapse: separate;

            border-spacing: 0;

            background: transparent;

        }



        .data-value { font-weight: 600; }

        .data-group tr td {
            background: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            padding: 12px 10px;
            border-bottom: 1px solid rgba(148, 163, 184, 0.15);
        }

        .data-group tr:last-of-type td { border-bottom: none; }



        .data-group tr:first-of-type td:first-child {

            border-radius: 10px 0 0 0;

        }



        .data-group tr:first-of-type td:last-child {

            border-radius: 0 10px 0 0;

        }



        .data-group tr:last-of-type td:first-child {

            border-radius: 0 0 0 10px;

        }



        .data-group tr:last-of-type td:last-child {

            border-radius: 0 0 10px 0;

        }

        .data-group.day-freeze td:not(:first-child),
        .data-group.month-freeze td:not(:first-child),
        .data-group.valve-log td:not(:first-child) {
            text-align: center;
        }

        

        .gas-table td {

            padding: 10px 8px;

            vertical-align: middle;

        }



        .gas-table input[type=text] {

            width: 100%;

            box-sizing: border-box;

            padding: 6px 8px;

            border: 1px solid #cbd5e1;

            border-radius: 6px;

            font-size: 13px;

        }

 /* 标签文字样式 */

        .label-text {

            font-weight: 600;

            color: #334155;

            white-space: nowrap;

        }

        

        .required {

            color: #ef4444;

            margin-right: 4px;

        }

        .btn-blue {

            background: linear-gradient(135deg, #007bff, #0056b3);

            color: white;

            border: none;

            border-radius: 10px;

            padding: 10px 24px;

            font-size: 14px;

            font-weight: 500;

            cursor: pointer;

            transition: all 0.2s;

            width: 50%;

            box-shadow: 0 2px 5px rgba(70, 233, 242, 0.746);

        }



        .btn-blue:hover {

            transform: translateY(-1px);

            box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);

            background: linear-gradient(135deg, #0056b3, #003d80);

        }

        

        .btn-blue:active {

        transform: translateY(1px);

        }



            .btn-green {

            background: linear-gradient(135deg, #0fe2d1, #08bee7);

            color: white;

            border: none;

            border-radius: 10px;

            padding: 10px 24px;

            font-size: 14px;

            font-weight: 500;

            cursor: pointer;

            transition: all 0.2s;

            width: 50%;

            box-shadow: 0 2px 5px rgba(188, 217, 215, 0.917);

        }



        .btn-green:hover {

            transform: translateY(-1px);

            box-shadow: 0 4px 12px rgba(26, 241, 216, 0.3);

            background: linear-gradient(135deg, #0056b3, #044777);

        }

        

        .btn-green:active {

            transform: translateY(1px);

        }



         .input-error { border: 2px solid #ef4444 !important; background: #fef2f2; }
        .error-hint { color: #ef4444; font-size: 12px; margin-left: 4px; display: none; }
        .error-hint.show { display: inline; }

        @media (max-width: 900px) {

            .glass-card {

                padding: 20px;

            }

            

            .gas-table td {

                display: block;

                width: 100% !important;

                padding: 8px;

            }

             .label-text {

                margin-bottom: 4px;

            }



            h3 {

                font-size: 20px;

            }

        }

    /* ===== 日冻结日历弹窗 (iOS26 毛玻璃风格) ===== */
    .cal-overlay {
        display: none;
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.38);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        z-index: 1000;
        justify-content: center; align-items: center;
    }
    .cal-overlay.show { display: flex; }
    .cal-container {
        max-width: 560px; width: 92%;
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(24px) saturate(1.2);
        -webkit-backdrop-filter: blur(24px) saturate(1.2);
        border-radius: 28px;
        padding: 28px 30px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.35);
        animation: calFadeIn 0.25s ease;
    }
    @keyframes calFadeIn {
        from { opacity: 0; transform: translateY(-20px) scale(0.96); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .cal-header {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 20px;
    }
    .cal-header h3 {
        margin: 0; font-size: 20px; letter-spacing: 1px; color: #1e293b;
    }
    .cal-header h3::after { display: none; }
    .cal-close {
        background: none; border: none; font-size: 26px; color: #94a3b8;
        cursor: pointer; line-height: 1; padding: 0 6px; transition: color 0.2s;
    }
    .cal-close:hover { color: #334155; }
    .cal-nav {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 16px;
    }
    .cal-nav .btn-blue { width: auto; min-width: 72px; padding: 8px 16px; }
    .cal-nav-title {
        font-size: 18px; font-weight: 600; color: #1e293b;
    }
    .cal-grid {
        width: 100%; border-collapse: separate; border-spacing: 4px;
        table-layout: fixed;
    }
    .cal-grid th {
        text-align: center; padding: 6px 0; font-size: 12px;
        font-weight: 600; color: #94a3b8;
    }
    .cal-grid td {
        width: 14.28%; height: 66px;
        text-align: center; vertical-align: middle;
        border-radius: 12px;
        font-size: 12px;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        transition: all 0.2s ease;
        cursor: default;
    }
    .cal-grid td.outrange {
        background: rgba(255, 255, 255, 0.35);
        color: #cbd5e1;
        box-shadow: inset 0 0 0 1px rgba(148, 163, 184, 0.08);
    }
    .cal-grid td.invalid {
        background: rgba(0, 0, 0, 0.12);
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    }
    .cal-grid td.normal {
        background: rgba(255, 255, 255, 0.55);
        box-shadow: 0 2px 8px rgba(15, 226, 209, 0.12),
                    inset 0 0 0 1px rgba(15, 226, 209, 0.10);
    }
    .cal-grid td.normal:hover {
        background: rgba(255, 255, 255, 0.75);
        box-shadow: 0 4px 14px rgba(15, 226, 209, 0.20);
        transform: translateY(-1px);
    }
    .cal-grid td.empty {
        background: transparent; box-shadow: none;
    }
    .cal-grid td.today {
        box-shadow: inset 0 0 0 2px #007bff !important;
    }
    .cal-day-num {
        display: block; font-weight: 600; font-size: 14px; color: #334155;
        margin-bottom: 2px;
    }
    .cal-grid td.outrange .cal-day-num { color: #cbd5e1; }
    .cal-grid td.invalid .cal-day-num { color: #475569; }
    .cal-day-val {
        display: block; font-size: 10px; font-weight: 500;
        color: #0891b2;
    }
    .cal-day-val.invalid-text {
        color: #ef4444; font-weight: 600;
    }
    .cal-legend {
        display: flex; gap: 24px; justify-content: center;
        margin-top: 18px; font-size: 12px; color: #64748b;
    }
    .cal-legend .dot {
        display: inline-block; width: 10px; height: 10px;
        border-radius: 3px; margin-right: 5px; vertical-align: middle;
    }
    .dot-normal   { background: rgba(255,255,255,0.55); box-shadow: 0 1px 3px rgba(15,226,209,0.15); }
    .dot-invalid  { background: rgba(0,0,0,0.15); }
    .dot-outrange { background: rgba(255,255,255,0.30); box-shadow: inset 0 0 0 1px rgba(148,163,184,0.10); }
    .cal-footer {
        text-align: center; margin-top: 18px;
    }

    /* ===== 月冻结列表弹窗 (与日冻结风格统一) ===== */
    .mon-overlay {
        display: none;
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.38);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        z-index: 1000;
        justify-content: center; align-items: center;
    }
    .mon-overlay.show { display: flex; }
    .mon-container {
        max-width: 480px; width: 90%;
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(24px) saturate(1.2);
        -webkit-backdrop-filter: blur(24px) saturate(1.2);
        border-radius: 28px;
        padding: 28px 30px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.35);
        animation: calFadeIn 0.25s ease;
    }
    .mon-container h3 { margin: 0; font-size: 20px; letter-spacing: 1px; color: #1e293b; }
    .mon-container h3::after { display: none; }
    .mon-list {
        width: 100%; border-collapse: separate; border-spacing: 0 6px;
        margin: 16px 0; max-height: 420px; overflow-y: auto; display: block;
    }
    .mon-list tr {
        display: flex; align-items: center;
        background: rgba(255, 255, 255, 0.45);
        border-radius: 12px;
        padding: 10px 16px;
        transition: all 0.15s ease;
    }
    .mon-list tr.normal {
        box-shadow: 0 1px 4px rgba(15, 226, 209, 0.08);
    }
    .mon-list tr.normal:hover {
        background: rgba(255, 255, 255, 0.65);
        transform: translateX(2px);
    }
    .mon-list tr.invalid {
        background: rgba(0, 0, 0, 0.10);
    }
    .mon-list tr.outrange {
        background: rgba(255, 255, 255, 0.25);
    }
    .mon-month {
        flex: 0 0 140px; font-weight: 600; font-size: 14px; color: #334155;
    }
    .mon-list tr.outrange .mon-month { color: #cbd5e1; }
    .mon-list tr.invalid .mon-month { color: #475569; }
    .mon-value {
        flex: 1; text-align: right; font-size: 14px; font-weight: 500; color: #0891b2;
    }
    .mon-value.invalid-text { color: #ef4444; font-weight: 600; }
    .mon-list tr.outrange .mon-value { color: #cbd5e1; }
    .mon-divider {
        width: 1px; height: 20px; background: rgba(148, 163, 184, 0.15);
        margin: 0 14px;
    }

    </style>

</head>



<body>

    <div class="glass-card">

    <h3>燃气卡读写</h3>



    
    <table class="gas-table" border="0"><tbody class="data-group token-input">
<tr>
                <td style="width:8%;text-align:right;"><span class="label-text">卡基本信息</span></td>   

            <td style="width:20%"><INPUT class="btn-blue"   id=send type=button value=读卡 onclick="ReadTypeACPUCard()" />

            </td>
            <td></td>
			<td style="width:20%"><INPUT class="btn-green" id=clear type=button value=清除日志 onclick="ClearLog()" /></td>
            <td></td>
			<td style="width:13%"><INPUT class="btn-blue" id=send type=button value=写token onclick="writeTypeACPUCard()" /></td>



            <td style="width:6%;text-align:right"><span class="required">*</span><span class="label-text">token数</span></td>

            <td style="width:13%"><SELECT id=tokenNum>

                <option value="1">1</option>

                <option value="2">2</option>

                <option value="3" selected>3</option>

                <option value="4">4</option>

                <option value="5">5</option>

            </SELECT></td>


</tr>


        <tr>
            <td style="width:6%;text-align:right"><span class="label-text">卡序列号: </span></td>

            <td style="width:13%"><INPUT id=cardID readonly type=text value="" /></td>


            <td style="width:7%;text-align:right"><span class="required">*</span><span class="label-text">token1:</span> </td>

            <td style="width:14%"><INPUT id=tokenID1 value="" type=text oninput="validateToken('tokenID1')" /><span class="error-hint" id="tokenID1Hint">请输入20位数字</span></td>

            <td style="width:5%;text-align:right"><span class="required">*</span><span class="label-text">result1</span> </td>

            <td style="width:5%"><INPUT  id=result1  type=text value="" /></td>

            <td style="width:5%;text-align:right"><span class="required">*</span><span class="label-text">TID1</span> </td>

            <td style="width:5%"><INPUT  id=TID1  type=text value="" /></td>


            

            

            

        </tr>

        <tr>

            

            <td style="width:8%;text-align:right"><span class="required">*</span><span class="label-text">密钥(16字节): </span></td>

            <td style="width:20%"><INPUT id=key type=text maxlength="32" value="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF" placeholder="57415443484441544154696D65434F53" oninput="validateKey()" /><span class="error-hint" id="keyHint">请输入32位密钥(16字节)</span>

            </td>






            <td style="width:7%;text-align:right"><span class="required">*</span><span class="label-text">token2:</span></td>

            <td style="width:14%"><INPUT id=tokenID2 value="" type=text oninput="validateToken('tokenID2')" /><span class="error-hint" id="tokenID2Hint">请输入20位数字</span></td>

            <td style="width:5%;text-align:right"><span class="required">*</span><span class="label-text">result2 </span></td>

            <td style="width:5%"><INPUT id=result2  type=text value="" /></td>

                        <td style="width:5%;text-align:right"><span class="required">*</span><span class="label-text">TID2 </span></td>


            <td style="width:5%"><INPUT id=TID2  type=text value="" /></td>






            

        </tr>

        <tr>

            <td style="width:8%;text-align:right"><span class="label-text">表号ID:</span> </td>

            <td style="width:20%"><INPUT id=utilityID type=text value="" /></td>





            <td style="width:7%;text-align:right"><span class="required">*</span><span class="label-text">token3:</span></td>

            <td style="width:14%"><INPUT id=tokenID3 value="" type=text oninput="validateToken('tokenID3')" /><span class="error-hint" id="tokenID3Hint">请输入20位数字</span></td>

            <td style="width:5%;text-align:right"><span class="required">*</span><span class="label-text">result3 </span></td>

            <td style="width:5%"><INPUT id=result3  type=text value="" /></td>

                        <td style="width:5%;text-align:right"><span class="required">*</span><span class="label-text">TID3 </span></td>

            <td style="width:5%"><INPUT id=TID3  type=text value="" /></td>






        </tr>

        <tr>
            <td style="width:6%;text-align:right"><span class="label-text">用户ID: </span></td>

            <td style="width:13%"><INPUT id=userID type=text value="" /></td>
			
			

			


            <td style="width:7%;text-align:right"><span class="required">*</span><span class="label-text">token4:</span></td>

            <td style="width:14%"><INPUT id=tokenID4 value="" type=text oninput="validateToken('tokenID4')" /><span class="error-hint" id="tokenID4Hint">请输入20位数字</span></td>

            <td style="width:5%;text-align:right"><span class="required">*</span><span class="label-text">result4 </span></td>

            <td style="width:5%"><INPUT id=result4  type=text value="" /></td>

            <td style="width:5%;text-align:right"><span class="required">*</span><span class="label-text">  TID4 </span></td>

            <td style="width:5%"><INPUT id=TID4  type=text value="" /></td>






        </tr>

        <tr>

			<td></td>
			<td></td>

            <td style="width:7%;text-align:right"><span class="required">*</span><span class="label-text">token5:</span></td>

            <td style="width:14%"><INPUT id=tokenID5 value="" type=text oninput="validateToken('tokenID5')" /><span class="error-hint" id="tokenID5Hint">请输入20位数字</span></td>

            <td style="width:5%;text-align:right"><span class="required">*</span><span class="label-text">result5 </span></td>

            <td style="width:5%"><INPUT id=result5  type=text value="" /></td>

                        <td style="width:5%;text-align:right"><span class="required">*</span><span class="label-text">TID5 </span></td>

            <td style="width:5%"><INPUT id=TID5  type=text value="" /></td>






        </tr>
        </tbody></table>

    <table class="gas-table" border="0"><tbody class="data-group card-info">
        <tr>
			            <td style="width:9%;text-align:right"><span class="label-text">卡类型:</span> </td>

            <td style="width:16%"><span id="cardType" class="data-value"></span></td>

            <td style="width:9%;text-align:right"><span class="label-text">读取日期:</span> </td>

            <td style="width:16%"><span id="readDate" class="data-value"></span></td>

			            <td style="width:9%;text-align:right"><span class="label-text">表状态:</span> </td>

            <td style="width:16%"><span id="meterStatus" class="data-value"></span></td>

            <td style="width:9%;text-align:right"><span class="label-text">累计气量(m³):</span> </td>

            <td style="width:16%"><span id="totalGas" class="data-value"></span></td>


		</tr>

        <tr>

            <td style="width:9%;text-align:right"><span class="label-text">信用额度(m³):</span> </td>

            <td style="width:16%"><span id="creditLimit" class="data-value"></span></td>

            <td style="width:9%;text-align:right"><span class="label-text">表内余额(m³):</span> </td>

            <td style="width:16%"><span id="balance" class="data-value"></span></td>

            <td style="width:9%;text-align:right"><span class="label-text">主电电压(mV):</span> </td>

            <td style="width:16%"><span id="mainVoltage" class="data-value"></span></td>

			<td></td>
			<td></td>



        </tr>
        </tbody></table>

    <table class="gas-table" border="0"><tbody class="data-group day-freeze">
        <tr>
            <td style="width:16%;text-align:right"><span class="label-text">日冻结:</span></td>
            <td colspan="7">
                <span id="dayFreezeSummary" class="data-value" style="margin-right:16px;"></span>
                <button class="btn-blue" style="width:auto;padding:6px 18px;"
                    onclick="showDailyFreezeCalendar()">查看日冻结数据</button>
            </td>
        </tr>
    </tbody></table>

    <table class="gas-table" border="0"><tbody class="data-group month-freeze">
        <tr>
            <td style="width:16%;text-align:right"><span class="label-text">月冻结:</span></td>
            <td colspan="7">
                <span id="monFreezeSummary" class="data-value" style="margin-right:16px;"></span>
                <button class="btn-blue" style="width:auto;padding:6px 18px;"
                    onclick="showMonthlyFreezePopup()">查看月冻结数据</button>
            </td>
        </tr>
    </tbody></table>

    <table class="gas-table" border="0"><tbody class="data-group valve-log">
		 <tr>

            <td></td>

            <td style="width:12%;text-align:center"><span class="label-text">时间</span> </td>

            <td></td>

           <td style="width:12%;text-align:center"><span class="label-text">事件类型</span> </td>

            <td></td>

            <td style="width:12%;text-align:center"><span class="label-text">详情</span> </td>

            <td></td>

            <td></td>

        </tr>

        <tr>

            <td style="width:12%;text-align:right"><span class="label-text">关阀事件记录1:</span> </td>

            <td style="width:22%"><span id="event_datetime1" class="data-value"></span></td>

            <td></td>

            <td style="width:8%"><span id="event_type1" class="data-value"></span></td>

            <td></td>

            <td style="width:6%"><span id="event_details1" class="data-value"></span></td>

            <td></td>

            <td></td>

        </tr>
		<tr>

            <td style="width:12%;text-align:right"><span class="label-text">关阀事件记录2:</span> </td>

            <td style="width:22%"><span id="event_datetime2" class="data-value"></span></td>

            <td></td>

            <td style="width:8%"><span id="event_type2" class="data-value"></span></td>

            <td></td>

            <td style="width:6%"><span id="event_details2" class="data-value"></span></td>

            <td></td>

            <td></td>

        </tr>
				<tr>

            <td style="width:12%;text-align:right"><span class="label-text">关阀事件记录3:</span> </td>

            <td style="width:22%"><span id="event_datetime3" class="data-value"></span></td>

            <td></td>

            <td style="width:8%"><span id="event_type3" class="data-value"></span></td>

            <td></td>

            <td style="width:6%"><span id="event_details3" class="data-value"></span></td>

            <td></td>

            <td></td>

        </tr>

        </tbody></table>

    </div> -->

    

    <table style="width: 98%;">

        <tr>

            <td colspan=8>

                <textarea id="messageText" name="messageText" rows="20" style="width:99%" readonly></textarea>

            </td>

        </tr>

    </table>

</div>

<!-- ===== 日冻结日历弹窗 ===== -->
<div id="calOverlay" class="cal-overlay" onclick="if(event.target===this)closeCalendar()">
    <div class="cal-container">
        <div class="cal-header">
            <h3>日冻结数据</h3>
            <button class="cal-close" onclick="closeCalendar()">&times;</button>
        </div>
        <div class="cal-nav">
            <button class="btn-blue" onclick="changeCalendarMonth(-1)">◀ 上月</button>
            <span class="cal-nav-title" id="calTitle"></span>
            <button class="btn-blue" onclick="changeCalendarMonth(1)">下月 ▶</button>
        </div>
        <table class="cal-grid">
            <thead><tr><th>日</th><th>一</th><th>二</th><th>三</th><th>四</th><th>五</th><th>六</th></tr></thead>
            <tbody id="calBody"></tbody>
        </table>
        <div class="cal-legend">
            <span><span class="dot dot-normal"></span> 正常数据</span>
            <span><span class="dot dot-invalid"></span> 无效数据</span>
            <span><span class="dot dot-outrange"></span> 超范围</span>
        </div>
        <div class="cal-footer">
            <button class="btn-blue" style="width:auto;padding:8px 28px;" onclick="closeCalendar()">关闭</button>
        </div>
    </div>
</div>

<!-- ===== 月冻结列表弹窗 ===== -->
<div id="monOverlay" class="mon-overlay" onclick="if(event.target===this)closeMonthlyPopup()">
    <div class="mon-container">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <h3>月冻结数据</h3>
            <button style="background:none;border:none;font-size:26px;color:#94a3b8;cursor:pointer;"
                onclick="closeMonthlyPopup()">&times;</button>
        </div>
        <table class="mon-list">
            <tbody id="monBody"></tbody>
        </table>
        <div class="cal-footer">
            <button class="btn-blue" style="width:auto;padding:8px 28px;" onclick="closeMonthlyPopup()">关闭</button>
        </div>
    </div>
</div>

</body>

<script type="text/javascript" src="./dcrf32_client.js"></script>

<script type="text/javascript" src="./crypto-js.min.js"></script>

<script type="text/javascript" src="./typeacpu_command.js"></script>

<script type="text/javascript" src="./typeacpu_util.js"></script>

<script type="text/javascript">

    var handle;

    var i1 = 0, i2 = 0;

    var dailyFreeze = { startYear: 0, startMonth: 0, startDay: 0, dayCount: 0, values: [] };
    var calYear = 0, calMonth = 0;

    var monthFreeze = { startYear: 0, startMonth: 0, monCount: 0, values: [] };

    var messageText = document.getElementById("messageText");

    // ===== 输入校验函数 =====
    validateKey = function () {
        var el = document.getElementById("key");
        var hint = document.getElementById("keyHint");
        if (el.value.length !== 32) {
            el.classList.add("input-error");
            if (hint) hint.classList.add("show");
            return false;
        } else {
            el.classList.remove("input-error");
            if (hint) hint.classList.remove("show");
            return true;
        }
    };

    validateToken = function (id) {
        var el = document.getElementById(id);
        var hint = document.getElementById(id + "Hint");
        var val = el.value;
        if (val.length !== 20 || !/^\d{20}$/.test(val)) {
            el.classList.add("input-error");
            if (hint) hint.classList.add("show");
            return false;
        } else {
            el.classList.remove("input-error");
            if (hint) hint.classList.remove("show");
            return true;
        }
    };

ReadTypeACPUCard = async function () {

        if (!validateKey()) { alert("密钥长度不正确，请输入32位十六进制密钥（16字节）"); return; }

        var r;

        i1 = 1;

        messageText.value = messageText.value + i1 + ".初始化连接" + "\r\n";

        r = await InitTypeACPU();

        if (r.code != 0) {

            alert("初始化连接失败");

            return;

        }else{

            handle = r.data.handle;

            document.getElementById("cardID").value = r.data.cardID;

        }

        i1 = i1 + 1;

        messageText.value = messageText.value + i1 + ".读取MF主目录文件" + "\r\n";

        await readMFFile();

        i1 = i1 + 1;

        messageText.value = messageText.value + i1 + ".读取应用ADF01目录文件" + "\r\n";

        await readADF01File();

    }

    writeTypeACPUCard = async function () {

        var tokenNames = ["tokenID1", "tokenID2", "tokenID3", "tokenID4", "tokenID5"];
        for (var i = 0; i < tokenNames.length; i++) {
            if (!validateToken(tokenNames[i])) {
                alert("第" + (i + 1) + "个token输入不合法，请输入20位数字");
                return;
            }
        }

        var r;

        i1 = 1;

        messageText.value = messageText.value + i1 + ".初始化连接" + "\r\n";

        r = await InitTypeACPU();

        if (r.code != 0) {

            alert("初始化连接失败");

            return;

        }else{

            handle = r.data.handle;

            document.getElementById("cardID").value = r.data.cardID;

        }

        i1 = i1 + 1;

        messageText.value = messageText.value + i1 + ".写token" + "\r\n";

        await writeTokenFile();

        

    }

    writeTokenFile = async function () {

        fileId = "001C";

        i2 = 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".选择MF主目录文件" + "\r\n";

        sdata = cmd_SelectFileByID("3F00");

        r = await CommandTypeACPU(sdata);

        if(r.code!="9000"){

            alert("选择MF主目录文件失败:"+r.code);

            return;

        }

        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".外部认证" + "\r\n";

        r = await TripleDesExternalAuthenticate("00");

        if(r.code!="9000" && r.data!="9000"){

            alert("外部认证失败:"+r.code);

        //	return;

        }

        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".选择卡应用ADF01目录文件" + "\r\n";

        sdata = cmd_SelectFileByID("1001");

        r = await CommandTypeACPU(sdata);

        if(r.code!="9000"){

            alert("选择卡应用ADF目录文件失败:"+r.code);

            return;

        }

        i2 = i2 + 1;

        messageText.value = messageText.value + i1 + "-" + i2 + ".写充值TOKEN" + "\r\n";

        var token1 = document.getElementById("tokenID1").value

        var result1 = '99'

        var token2 = document.getElementById("tokenID2").value

        var result2 = '99'

        var token3 = document.getElementById("tokenID3").value

        var result3 = '99'

        var token4 = document.getElementById("tokenID4").value

        var result4 = '99'

        var token5 = document.getElementById("tokenID5").value

        var result5 = '99'

        var tokenNum = document.getElementById("tokenNum").value

        var token = tokenNum.toString(16).padStart(2, '0') + bytesToHex(decimal20ToBCD10(token1))  + bytesToHex(decimal20ToBCD10(token2)) + bytesToHex(decimal20ToBCD10(token3)) + bytesToHex(decimal20ToBCD10(token4)) + bytesToHex(decimal20ToBCD10(token5))

        sdata=cmd_UpdateBinary("00", token);

        var result = await WriteFile(fileId, sdata);

    }



        getCardTypeText = function (val) {

            if (val === "01" || val === "1") return "用户卡";

            if (val === "02" || val === "2") return "维护卡";

            return "未知卡";

        }



        parsePaddedFrame = function (hexStr) {

            var len = parseInt(hexStr.slice(0, 2), 16);

            var dataHex = hexStr.slice(2, 2 + len * 2);

            return ascii2str(dataHex);

        }

        formatReadDate = function (hexStr) {
            var year = parseInt(hexStr.slice(0, 4), 16);
            var month = parseInt(hexStr.slice(4, 6), 16);
            var day = parseInt(hexStr.slice(6, 8), 16);
            var weekday = parseInt(hexStr.slice(8, 10), 16);
            var hour = parseInt(hexStr.slice(10, 12), 16);
            var minute = parseInt(hexStr.slice(12, 14), 16);
            var second = parseInt(hexStr.slice(14, 16), 16);
            return year + "年" + month + "月" + day + "日 星期" + weekday + " " +
                hour.toString().padStart(2, "0") + ":" +
                minute.toString().padStart(2, "0") + ":" +
                second.toString().padStart(2, "0");
        }



        // tokenToHex =  function(tokenStr){

    // 	// 字符串转UTF8字节，再转十六进制

    // 	let hex = '';

    // 	for (let i = 0; i < tokenStr.length; i++) {

    // 		hex += tokenStr.charCodeAt(i).toString(16).padStart(2, '0');

    // 	}



    // 	// 固定 40 位（20字节），不足补0，超长截断

    // 	return hex.padEnd(40, '0').slice(0, 40).toUpperCase();

    // }

    WriteFile = async function(fileId,fileData){

        var result = await WriteFileData(fileId,fileData,key.value);

        var sw=result.data.substr(result.data.length-4,4);

        if(sw=="")sw=result.code;

        result.code=sw;

        messageText.value = messageText.value + result.msg;

        return result;

    }



    readMFFile = async function() {

        i2 = 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".选择MF主目录文件" + "\r\n";

        sdata = cmd_SelectFileByID("3F00");

        r = await CommandTypeACPU(sdata);

        if(r.code!="9000"){

            alert("选择MF主目录文件失败:"+r.code);

            return;

        }

        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".外部认证" + "\r\n";

        r = await TripleDesExternalAuthenticate("00");

        if(r.data!="9000" && r.code!="9000"){

            alert("外部认证失败:"+r.code);

        //	return;

        }



        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".选择0016" + "\r\n";

        sdata = cmd_SelectFileByID("0016");

        r = await CommandTypeACPU(sdata);

        if(r.code!="9000"){

            alert("选择0016:"+r.code);

            return;

        }



        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".读取持卡人基本信息" + "\r\n";

        r = await CommandTypeACPU(ReadBinary("00", "2B"));;

        if(r.code!="9000"){

            alert("读取持卡人基本信息失败:"+r.code);

            document.getElementById("cardType").textContent = "未知卡"

            document.getElementById("utilityID").value = "NaN";

            document.getElementById("userID").value = "NaN"

        //	return;

        }else{

            var cardTypeVal = r.data.slice(0, 2);

            document.getElementById("cardType").textContent = getCardTypeText(cardTypeVal);

            document.getElementById("utilityID").value = parsePaddedFrame(r.data.slice(2, 44));

            document.getElementById("userID").value = parsePaddedFrame(r.data.slice(44, 86));

        }

    }



    readADF01File = async function(){

        i2 = 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".选择卡应用ADF01目录文件" + "\r\n";

        sdata = cmd_SelectFileByID("1001");

        r = await CommandTypeACPU(sdata);

        if(r.code!="9000"){

            alert("选择卡应用ADF目录文件失败:"+r.code);

            return;

        }

        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".卡应用认证" + "\r\n";

        r = await TripleDesExternalAuthenticate("01");

        if(r.code!="9000" && r.data!="9000"){

            alert("卡应用认证失败:"+r.code);

        //	return;

        }

        // i2 = i2 + 1;

        // messageText.value = messageText.value + i1 +"-"+ i2 + ".读取剩余水量" + "\r\n";

        // r = await CommandTypeACPU(ReadEpBalance());

        // if(r.code!="9000"){

        // 	alert("读取剩余水量失败:"+r.code);

        // 	document.getElementById("balance").textContent = "NaN";

        // //	return;

        // }else{

        // 	document.getElementById("balance").value = parseInt((r.data.substr(0, 8)), 16) / 10;

        // }

        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".选择0008" + "\r\n";

        sdata = cmd_SelectFileByID("0008");

        r = await CommandTypeACPU(sdata);

        if(r.code!="9000"){

            alert("选择0008:"+r.code);

            return;

        }



        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".读取燃气表状态" + "\r\n";

        cmd_SelectFileByID("0008");

        r = await CommandTypeACPU(ReadBinary("00", "22"));;

        if(r.code!="9000"){

            alert("读取燃气表状态失败:"+r.code);

            document.getElementById("readDate").textContent = "NaN";

            document.getElementById("meterStatus").textContent = "NaN";

            document.getElementById("totalGas").textContent = "NaN";

            document.getElementById("creditLimit").textContent = "NaN";

            document.getElementById("balance").textContent = "NaN";

            document.getElementById("mainVoltage").textContent = "NaN";



        //	return;

        }else{

            document.getElementById("readDate").textContent = formatReadDate(r.data.slice(0, 24));

            document.getElementById("meterStatus").textContent = r.data.slice(24, 32);

            var mask_status = parseInt(r.data.slice(32, 40), 16);

            document.getElementById("totalGas").textContent = parseInt(r.data.slice(40, 48), 16);

            document.getElementById("creditLimit").textContent = parseInt(r.data.slice(48, 56), 16);

            document.getElementById("balance").textContent = parseInt(r.data.slice(56, 64), 16);

            document.getElementById("mainVoltage").textContent = parseInt(r.data.slice(64, 68), 16);

        }

        // 读取日冻结文件0009

        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".选择0009" + "\r\n";

        sdata = cmd_SelectFileByID("0009");

        r = await CommandTypeACPU(sdata);

        if(r.code!="9000"){

            alert("选择0009:"+r.code);

        //  return;

        }


        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".读取日冻结数据" + "\r\n";

        cmd_SelectFileByID("0009");

        r = await CommandTypeACPU(ReadBinary("00", "0178"));;

        if(r.code!="9000"){

            alert("读取日冻结数据失败:"+r.code);

            dailyFreeze = { startYear: 0, startMonth: 0, startDay: 0, dayCount: 0, values: [] };
            document.getElementById("dayFreezeSummary").textContent = "读取失败";

        //  return;

        }else{

            dailyFreeze.startYear = parseInt(r.data.slice(0, 2), 16);
            dailyFreeze.startMonth = parseInt(r.data.slice(2, 4), 16);
            dailyFreeze.startDay = parseInt(r.data.slice(4, 6), 16);
            dailyFreeze.dayCount = parseInt(r.data.slice(6, 8), 16);
            dailyFreeze.values = [];
            for (var i = 0; i < 93; i++) {
                var offset = 8 + i * 8;
                if (offset + 8 <= r.data.length) {
                    dailyFreeze.values.push(parseInt(r.data.slice(offset, offset + 8), 16));
                } else {
                    dailyFreeze.values.push(0);
                }
            }

            if (dailyFreeze.dayCount > 0) {
                var sy = 2000 + dailyFreeze.startYear;
                document.getElementById("dayFreezeSummary").textContent =
                    sy + "年" + dailyFreeze.startMonth + "月" + dailyFreeze.startDay + "日起，共" + dailyFreeze.dayCount + "天";
            } else {
                document.getElementById("dayFreezeSummary").textContent = "暂无数据";
            }
        }


        // 读取月冻结文件000A

        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".选择000A" + "\r\n";

        sdata = cmd_SelectFileByID("000A");

        r = await CommandTypeACPU(sdata);

        if(r.code!="9000"){

            alert("选择000A:"+r.code);

        //  return;

        }


        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".读取月冻结数据" + "\r\n";

        cmd_SelectFileByID("000A");

        r = await CommandTypeACPU(ReadBinary("00", "33"));;

        if(r.code!="9000"){

            alert("读取月冻结数据失败:"+r.code);

            monthFreeze = { startYear: 0, startMonth: 0, monCount: 0, values: [] };
            document.getElementById("monFreezeSummary").textContent = "读取失败";

        //  return;

        }else{

            monthFreeze.startYear = parseInt(r.data.slice(0, 2), 16);
            monthFreeze.startMonth = parseInt(r.data.slice(2, 4), 16);
            monthFreeze.monCount = parseInt(r.data.slice(4, 6), 16);
            monthFreeze.values = [];
            for (var i = 0; i < 12; i++) {
                var offset = 6 + i * 8;
                if (offset + 8 <= r.data.length) {
                    monthFreeze.values.push(parseInt(r.data.slice(offset, offset + 8), 16));
                } else {
                    monthFreeze.values.push(0);
                }
            }

            if (monthFreeze.monCount > 0) {
                var sy = 2000 + monthFreeze.startYear;
                document.getElementById("monFreezeSummary").textContent =
                    sy + "年" + monthFreeze.startMonth + "月起，共" + monthFreeze.monCount + "个月";
            } else {
                document.getElementById("monFreezeSummary").textContent = "暂无数据";
            }
        }


        // 读取事件记录文件000B

        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".选择000B" + "\r\n";

        sdata = cmd_SelectFileByID("000B");

        r = await CommandTypeACPU(sdata);

        if(r.code!="9000"){

            alert("选择000B:"+r.code);

        //	return;

        }


        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".读取事件记录数据" + "\r\n";

        cmd_SelectFileByID("000B");

        r = await CommandTypeACPU(ReadBinary("00", "B5"));;

        if(r.code!="9000"){

        	alert("读取事件记录数据失败:"+r.code);

			document.getElementById("event_datetime1").textContent = "NaN";
			document.getElementById("event_datetime2").textContent = "NaN";
			document.getElementById("event_datetime3").textContent = "NaN";

			document.getElementById("event_type1").textContent = "NaN";
			document.getElementById("event_type2").textContent = "NaN";
			document.getElementById("event_type3").textContent = "NaN";

			document.getElementById("event_details1").textContent = "NaN";
			document.getElementById("event_details2").textContent = "NaN";
			document.getElementById("event_details3").textContent = "NaN";

        //	return;

        }else{

			// 关阀事件记录解析
			var eventCount = parseInt(r.data.slice(0, 2), 16);
			for (var ei = 0; ei < 3; ei++) {
			    var base = 2 + ei * 18;
			    var typeHex = r.data.slice(base, base + 4);
			    var timeHex = r.data.slice(base + 4, base + 16);
			    var detailHex = r.data.slice(base + 16, base + 18);
			    var ey = 2000 + parseInt(timeHex.slice(0, 2), 16);
			    var eM = parseInt(timeHex.slice(2, 4), 16);
			    var ed = parseInt(timeHex.slice(4, 6), 16);
			    var eh = parseInt(timeHex.slice(6, 8), 16);
			    var em = parseInt(timeHex.slice(8, 10), 16);
			    var es = parseInt(timeHex.slice(10, 12), 16);
			    var timeStr = ey + "年" + eM + "月" + ed + "日 " + eh + ":" + em + ":" + es;
			    var idx = ei + 1;
			    if (ei < eventCount) {
			        document.getElementById("event_type" + idx).textContent = typeHex;
			        document.getElementById("event_datetime" + idx).textContent = timeStr;
			        document.getElementById("event_details" + idx).textContent = detailHex;
			    } else {
			        document.getElementById("event_type" + idx).textContent = "";
			        document.getElementById("event_datetime" + idx).textContent = "";
			        document.getElementById("event_details" + idx).textContent = "";
			    }
			}
        }

        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".选择001C" + "\r\n";

        sdata = cmd_SelectFileByID("001C");

        r = await CommandTypeACPU(sdata);

        if(r.code!="9000"){

            alert("选择001C:"+r.code);

            return;

        }

        

        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".读取TOKEN码文件" + "\r\n";

        cmd_SelectFileByID("001C");

        r = await CommandTypeACPU(ReadBinary("00", "33"));;

        if(r.code!="9000"){

            alert("读取TOKEN码文件失败:"+r.code);

            document.getElementById("lastToken").value = "NaN";

        //	return;

        }else{

            document.getElementById("tokenNum").value = parseInt(r.data.slice(0, 2), 16);

            document.getElementById("tokenID1").value = bcdToDecimal(hexToBcd(r.data.slice(2, 22)));



            document.getElementById("tokenID2").value = bcdToDecimal(hexToBcd(r.data.slice(22, 42)));

            document.getElementById("tokenID3").value = bcdToDecimal(hexToBcd(r.data.slice(42, 62)));

            document.getElementById("tokenID4").value = bcdToDecimal(hexToBcd(r.data.slice(62, 82)));

            document.getElementById("tokenID5").value = bcdToDecimal(hexToBcd(r.data.slice(82, 102)));

            document.getElementById("lastToken").value = r.data;

        }





        // i2 = i2 + 1;

        // 读取TOKEN记录文件001D

        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".选择001D" + "\r\n";

        sdata = cmd_SelectFileByID("001D");

        r = await CommandTypeACPU(sdata);

        if(r.code!="9000"){

            alert("选择001D:"+r.code);

        //	return;

        }


        i2 = i2 + 1;

        messageText.value = messageText.value + i1 +"-"+ i2 + ".读取TOKEN记录文件" + "\r\n";

        cmd_SelectFileByID("001D");

        r = await CommandTypeACPU(ReadBinary("00", "14"));;

        if(r.code!="9000"){

            alert("读取TOKEN记录文件失败:"+r.code);

        //	return;

        }else{

            messageText.value = messageText.value + "TOKEN记录数据:" + r.data + "\r\n";

        }




        // messageText.value = messageText.value + i1 +"-"+ i2 + ".读取交易记录" + "\r\n";

        // r = await ReadTranRecords();

        // if(r.code!="9000" && r.code!="6A83"){

        // 	alert("读取交易记录失败:"+r.code);

        // //	return;

        // }

    }



    // LoadTypeACPUCard = async function () {

    // 	i1 = 1;

    // 	var terminalID = "112233445566";

    // 	var tranTime = dateFormat("YYYYMMDDHHmmss", new Date());

    // 	var amount = document.getElementById("loadAmount").value;

    // 	var reg = /^[-]{0,1}[0-9]+([.]{1}[0-9]){0,1}$/;

    // 	if(amount=="" || amount==0 || !reg.test(amount)){

    // 		alert("金额无效");

