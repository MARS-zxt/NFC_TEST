    ExternalAuthenticate = async function (keyID) {

        var result = await externalAuthenticate(keyID, document.getElementById("key").value);

        var sw=result.data.substr(result.data.length-4,4);

        if(sw=="")sw=result.code;

        result.code=sw;

        messageText.value = messageText.value + result.msg;

        return result;

    }



    TripleDesExternalAuthenticate = async function (keyID) {

        var result = await tripleDesExternalAuthenticate(keyID,document.getElementById("key").value);

        messageText.value = messageText.value + result.msg;

        return result;

    }



    



    CommandTypeACPU = async function (command) {

        var result = await sendCommand(command, handle);

        var sw=result.data.substr(result.data.length-4,4);

        if(sw=="")sw=result.code;

        result.code=sw;

        messageText.value = messageText.value + result.msg;

        return result;

    }



    InitTypeACPU = async function () {

        var result = await init();

        messageText.value = messageText.value + result.msg;

        return result;

    }



    ExitTypeACPU = async function () {

        result = await dc_exit(handle);

        messageText.value = messageText.value + "<<关闭设备成功" + "\r\n";

        return;

    }



    ClearLog = async function (command) {

        messageText.value = "";

    }

    // ===== 日冻结日历弹窗 =====

    showDailyFreezeCalendar = function () {
        if (dailyFreeze.dayCount <= 0) {
            alert("暂无日冻结数据，请先读卡");
            return;
        }
        calYear = 2000 + dailyFreeze.startYear;
        calMonth = dailyFreeze.startMonth;
        renderCalendar();
        document.getElementById("calOverlay").classList.add("show");
    };

    closeCalendar = function () {
        document.getElementById("calOverlay").classList.remove("show");
    };

    changeCalendarMonth = function (delta) {
        calMonth += delta;
        if (calMonth > 12) { calMonth = 1; calYear++; }
        if (calMonth < 1) { calMonth = 12; calYear--; }
        renderCalendar();
    };

    renderCalendar = function () {
        document.getElementById("calTitle").textContent = calYear + "年 " + calMonth + "月";

        var startMs = new Date(2000 + dailyFreeze.startYear, dailyFreeze.startMonth - 1, dailyFreeze.startDay).getTime();
        var today = new Date();
        today.setHours(0, 0, 0, 0);
        var todayMs = today.getTime();
        var INVALID = 0xFFFFFFFF;

        var firstDay = new Date(calYear, calMonth - 1, 1);
        var startDow = firstDay.getDay();
        var daysInMonth = new Date(calYear, calMonth, 0).getDate();

        var html = "";
        var cell = 0;

        for (var j = 0; j < startDow; j++) {
            html += "<td class='empty'></td>";
            cell++;
        }

        for (var day = 1; day <= daysInMonth; day++) {
            if (cell % 7 === 0) html += "<tr>";
            var cellMs = new Date(calYear, calMonth - 1, day).getTime();
            var dayIndex = Math.round((startMs - cellMs) / 86400000);
            var isToday = (cellMs === todayMs);

            var cls = "";
            var content = "<span class='cal-day-num'>" + day + "</span>";

            if (dayIndex < 0 || dayIndex >= dailyFreeze.dayCount || dayIndex >= 93) {
                cls = "outrange";
            } else if (dailyFreeze.values[dayIndex] === INVALID) {
                cls = "invalid";
                content += "<span class='cal-day-val invalid-text'>无效数据</span>";
            } else {
                cls = "normal";
                content += "<span class='cal-day-val'>" + dailyFreeze.values[dayIndex] + "</span>";
            }

            if (isToday) cls += " today";

            html += "<td class='" + cls + "'>" + content + "</td>";
            cell++;
            if (cell % 7 === 0) html += "</tr>";
        }

        var rem = 7 - (cell % 7);
        if (rem < 7) {
            for (var k = 0; k < rem; k++) html += "<td class='empty'></td>";
        }

        document.getElementById("calBody").innerHTML = html;
    };

    // ===== 月冻结列表弹窗 =====

    showMonthlyFreezePopup = function () {
        if (monthFreeze.monCount <= 0) {
            alert("暂无月冻结数据，请先读卡");
            return;
        }
        renderMonthList();
        document.getElementById("monOverlay").classList.add("show");
    };

    closeMonthlyPopup = function () {
        document.getElementById("monOverlay").classList.remove("show");
    };

    renderMonthList = function () {
        var INVALID = 0xFFFFFFFF;
        var startDate = new Date(2000 + monthFreeze.startYear, monthFreeze.startMonth - 1, 1);
        var html = "";

        for (var i = 0; i < 12; i++) {
            var md = new Date(startDate);
            md.setMonth(md.getMonth() - i);
            var label = md.getFullYear() + "年" + (md.getMonth() + 1) + "月";

            var cls = "";
            var valHtml = "";

            if (i >= monthFreeze.monCount) {
                cls = "outrange";
                valHtml = "<span class='mon-value'>无数据</span>";
            } else if (monthFreeze.values[i] === INVALID) {
                cls = "invalid";
                valHtml = "<span class='mon-value invalid-text'>无效数据</span>";
            } else {
                cls = "normal";
                valHtml = "<span class='mon-value'>" + monthFreeze.values[i] + "</span>";
            }

            html += "<tr class='" + cls + "'>";
            html += "<td class='mon-month'>" + label + "</td>";
            html += "<td class='mon-divider'></td>";
            html += "<td>" + valHtml + "</td>";
            html += "</tr>";
        }

        document.getElementById("monBody").innerHTML = html;
    };

window.addEventListener('message', function(e) {
    if (e.data && e.data.type === 'setBackground') {
        document.body.style.backgroundImage = e.data.backgroundImage;
        document.body.style.backgroundSize = 'cover';
        document.body.style.backgroundAttachment = 'fixed';
    }
});

</script>



</html>